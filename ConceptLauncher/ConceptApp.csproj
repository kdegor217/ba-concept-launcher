<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>ConceptApp</RootNamespace>
    <AssemblyName>ConceptApp</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Fixed release builds: -p:LauncherVariant=E|G|H -->
    <LauncherVariant Condition="'$(LauncherVariant)' == ''"></LauncherVariant>
  </PropertyGroup>

  <!-- Keep AssemblyName=ConceptApp so avares://ConceptApp/... stays valid. -->
  <PropertyGroup Condition="'$(LauncherVariant)' != ''">
    <Product>ActualArrow Launcher — $(LauncherVariant)</Product>
    <DefineConstants>$(DefineConstants);LAYOUT_$(LauncherVariant)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <AvaloniaResource Include="Theme\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ActualArrow.Core\ActualArrow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
</Project>
