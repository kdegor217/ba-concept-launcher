<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConceptApp.ViewModels"
        x:Class="ConceptApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/app.ico"
        Title="Broken Arrow"
        Width="{Binding WindowWidth}"
        Height="{Binding WindowHeight}"
        SizeToContent="{Binding WindowSizeToContent}"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AA.BackgroundBrush}"
        Foreground="{DynamicResource AA.TextBrush}"
        FontFamily="Inter, Segoe UI, $Default"
        FontSize="13">

  <Panel>
    <!-- Shared blur atmosphere for B + G -->
    <Image Source="avares://ConceptApp/Assets/header.png"
           Stretch="UniformToFill" Opacity="0.48"
           IsVisible="{Binding IsLayoutB}">
      <Image.Effect>
        <BlurEffect Radius="48"/>
      </Image.Effect>
    </Image>
    <Border Background="#C21D1F23" IsVisible="{Binding IsLayoutB}"/>

    <!-- Concept B -->
    <Grid IsVisible="{Binding IsLayoutB}" RowDefinitions="Auto,*,Auto" Margin="28,22,28,16">
      <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
        <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource AA.PanelBrush}"
                BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="1">
          <Image Source="avares://ConceptApp/Assets/icon_256.png" Stretch="UniformToFill"/>
        </Border>
        <StackPanel VerticalAlignment="Center" Spacing="1">
          <TextBlock Classes="brand" Text="BROKEN ARROW"/>
          <TextBlock Classes="title" FontSize="18" Text="{Binding BrandSub}"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="1">
        <Border Background="#E023252A" BorderBrush="#B33A3D45" BorderThickness="1"
                CornerRadius="8" Padding="14" Margin="0,0,0,16">
          <Grid ColumnDefinitions="96,*">
            <Border Width="96" Height="96" CornerRadius="6" ClipToBounds="True"
                    Background="{DynamicResource AA.PanelBrush}">
              <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="muted" FontSize="11" FontWeight="SemiBold" Text="{Binding ModpackLabel}"/>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="ghost pack" Padding="0" MinHeight="24" Command="{Binding CyclePackCommand}">
                  <TextBlock Text="{Binding PackName}" FontSize="16" FontWeight="Bold"
                             TextTrimming="CharacterEllipsis"/>
                </Button>
                <Button Classes="ghost pack" Padding="4,0" MinHeight="24" MinWidth="22">
                  <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedLeft">
                      <MenuItem Header="release" Command="{Binding SelectBranchCommand}" CommandParameter="release"/>
                      <MenuItem Header="beta" Command="{Binding SelectBranchCommand}" CommandParameter="beta"/>
                      <MenuItem Header="dev" Command="{Binding SelectBranchCommand}" CommandParameter="dev"/>
                    </MenuFlyout>
                  </Button.Flyout>
                  <TextBlock Classes="muted" Text="▾" FontSize="11"/>
                </Button>
              </StackPanel>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding PackMetaLine}"/>
              <Border Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="999" Padding="8,3"
                      Classes.chipok="{Binding !UpdateAvailable}"
                      Classes.chipwarn="{Binding UpdateAvailable}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding ChipText}"/>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel>
            <Button Classes="primary" HorizontalAlignment="Stretch"
                    Content="{Binding PlayLabel}" Command="{Binding PlayCommand}"/>
            <Button Classes="ghost link" HorizontalAlignment="Center" Margin="0,10,0,0"
                    Content="{Binding VanillaLabel}" Command="{Binding VanillaCommand}"/>
          </StackPanel>
          <Button Grid.Column="1" Classes="ghost icon" VerticalAlignment="Center"
                  Width="48" Height="48" MinWidth="48" MinHeight="48" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Content="⚙" Command="{Binding SettingsCommand}"
                  ToolTip.Tip="{Binding SettingsTip}"/>
        </Grid>

        <StackPanel Margin="0,16,0,0" Spacing="8" IsVisible="{Binding IsBusy}">
          <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                       Foreground="{DynamicResource AA.AccentBrush}"
                       Background="{DynamicResource AA.PanelBrush}"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}"/>
            <Button Grid.Column="1" Classes="ghost link" Content="{Binding CancelLabel}"
                    Command="{Binding CancelCommand}" Padding="0" MinHeight="20"/>
          </Grid>
        </StackPanel>
      </StackPanel>

      <TextBlock Grid.Row="2" Classes="muted" FontSize="12" Margin="0,8,0,0"
                 Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" HorizontalAlignment="Center"
                 IsVisible="{Binding !IsBusy}"/>
    </Grid>

    <!-- Concept D: content-hugging bar -->
    <StackPanel IsVisible="{Binding IsLayoutD}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="10,6"
                  VerticalAlignment="Center" HorizontalAlignment="Left">
        <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                Background="{DynamicResource AA.PanelBrush}"
                VerticalAlignment="Center">
          <Image Source="avares://ConceptApp/Assets/icon_256.png" Stretch="UniformToFill"/>
        </Border>

        <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,4,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="ghost pack" Padding="0" MinHeight="22" Command="{Binding CyclePackCommand}">
              <TextBlock Text="{Binding PackName}" FontSize="14" FontWeight="SemiBold"/>
            </Button>
            <Button Classes="ghost pack" Padding="2,0" MinHeight="22" MinWidth="18">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                  <MenuItem Header="release" Command="{Binding SelectBranchCommand}" CommandParameter="release"/>
                  <MenuItem Header="beta" Command="{Binding SelectBranchCommand}" CommandParameter="beta"/>
                  <MenuItem Header="dev" Command="{Binding SelectBranchCommand}" CommandParameter="dev"/>
                </MenuFlyout>
              </Button.Flyout>
              <TextBlock Classes="muted" Text="▾" FontSize="11"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="muted" FontSize="12" Text="{Binding PackMetaLine}"
                       VerticalAlignment="Center"/>
            <Border CornerRadius="999" Padding="8,3" VerticalAlignment="Center"
                    Classes.chipok="{Binding !UpdateAvailable}"
                    Classes.chipwarn="{Binding UpdateAvailable}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding ChipText}"/>
            </Border>
          </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Height="40">
          <Button Classes="primary compact" VerticalAlignment="Center" Height="40"
                  Content="{Binding PlayLabel}" Command="{Binding PlayCommand}"/>
          <Button Classes="secondary compact" VerticalAlignment="Center" Height="40"
                  Content="{Binding VanillaLabel}" Command="{Binding VanillaCommand}"/>
          <Button Classes="ghost icon" VerticalAlignment="Center"
                  Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Content="⚙" Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}"/>
        </StackPanel>
      </StackPanel>

      <Border IsVisible="{Binding IsBusy}"
              BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="0,1,0,0"
              Background="#181A1E" Padding="10,8">
        <StackPanel Spacing="6">
          <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                       Foreground="{DynamicResource AA.AccentBrush}"
                       Background="{DynamicResource AA.PanelBrush}"/>
          <DockPanel LastChildFill="True">
            <Button DockPanel.Dock="Right" Classes="ghost link" Content="{Binding CancelLabel}"
                    Command="{Binding CancelCommand}" Padding="0" MinHeight="20" Margin="12,0,0,0"/>
            <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
          </DockPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Concept E — Rail -->
    <Grid IsVisible="{Binding IsLayoutE}" ColumnDefinitions="72,*">
      <Border Background="#151619" BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,14,0,14">
          <Border DockPanel.Dock="Top" Width="40" Height="40" CornerRadius="8" ClipToBounds="True"
                  BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="1"
                  HorizontalAlignment="Center" Margin="0,0,0,10">
            <Image Source="avares://ConceptApp/Assets/icon_256.png" Stretch="UniformToFill"/>
          </Border>
          <Button DockPanel.Dock="Bottom" Classes="rail" Content="⚙"
                  Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}"
                  HorizontalAlignment="Center" Margin="0,0,0,0"/>
          <StackPanel Spacing="8" HorizontalAlignment="Center">
            <Button Classes="rail primary" Content="{Binding PlayLabel}"
                    Command="{Binding PlayCommand}" ToolTip.Tip="{Binding PlayLabel}"/>
            <Button Classes="rail" Content="○"
                    Command="{Binding VanillaCommand}" ToolTip.Tip="{Binding VanillaLabel}"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="22,20,22,16" RowDefinitions="Auto,*">
        <TextBlock Classes="brand" Text="BROKEN ARROW" FontSize="11"/>
        <Grid Grid.Row="1" ColumnDefinitions="120,*" Margin="0,14,0,0" ColumnSpacing="16">
          <Border Width="120" Height="120" CornerRadius="6" ClipToBounds="True"
                  Background="{DynamicResource AA.PanelBrush}"
                  BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="1"
                  VerticalAlignment="Top">
            <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
          </Border>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
            <TextBlock Classes="muted" FontSize="11" FontWeight="SemiBold" LetterSpacing="1"
                       Text="{Binding ModpackLabel}"/>
            <TextBlock Text="{Binding PackName}" FontSize="24" FontWeight="Bold"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
            <TextBlock Classes="muted" FontSize="13" Margin="0,4,0,0" Text="{Binding PackMetaLine}"/>
            <Border Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="999" Padding="8,3"
                    Classes.chipok="{Binding !UpdateAvailable}"
                    Classes.chipwarn="{Binding UpdateAvailable}">
              <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding ChipText}"/>
            </Border>
            <TextBlock Classes="muted" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"
                       Text="{Binding Status}" IsVisible="{Binding !IsBusy}"/>
            <StackPanel Margin="0,12,0,0" Spacing="6" IsVisible="{Binding IsBusy}">
              <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                           Foreground="{DynamicResource AA.AccentBrush}"
                           Background="{DynamicResource AA.PanelBrush}"/>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}"/>
                <Button Grid.Column="1" Classes="ghost link" Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}" Padding="0" MinHeight="20"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>

    <!-- Concept G — Night HUD -->
    <Panel IsVisible="{Binding IsLayoutG}" Background="#0A0C0E">
      <Image Source="avares://ConceptApp/Assets/header.png"
             Stretch="UniformToFill" Opacity="0.7">
        <Image.Effect>
          <BlurEffect Radius="18"/>
        </Image.Effect>
      </Image>
      <Border Background="#990A0C0E"/>
      <!-- Corner frame -->
      <Border Margin="18,12,18,18" BorderBrush="#387EC8E8" BorderThickness="1" CornerRadius="4"
              IsHitTestVisible="False"/>
      <Border Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="17,11,0,0" BorderBrush="#B3E2A23A" BorderThickness="2,2,0,0"
              IsHitTestVisible="False"/>
      <Border Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,17,17" BorderBrush="#B3E2A23A" BorderThickness="0,0,2,2"
              IsHitTestVisible="False"/>

      <DockPanel Margin="28,28,28,18">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,22">
          <StackPanel>
            <TextBlock Text="{Binding HudCallsign}" FontSize="13" Foreground="#7EC8E8"
                       LetterSpacing="2" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PackName}" FontSize="28" FontWeight="Bold"
                       LetterSpacing="1" Margin="0,4,0,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
            <Ellipse Width="7" Height="7" Fill="#4CC26E" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ChipText}" FontSize="11" Foreground="#4CC26E"
                       FontWeight="SemiBold" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Top" Background="#8C0C1216" BorderBrush="#2E7EC8E8"
                BorderThickness="1" CornerRadius="4" Padding="16" Margin="0,0,0,18">
          <Grid ColumnDefinitions="100,*" ColumnSpacing="14">
            <Border Width="100" Height="100" CornerRadius="2" ClipToBounds="True"
                    BorderBrush="#59E2A23A" BorderThickness="1"
                    Background="{DynamicResource AA.PanelBrush}">
              <Image Source="{Binding Preview}" Stretch="UniformToFill"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding SelectedBranchName}" FontSize="10" Foreground="#7EC8E8"
                         LetterSpacing="2" FontWeight="SemiBold"/>
              <TextBlock Text="{Binding InstalledText}" FontSize="22" FontWeight="Bold" LetterSpacing="1"/>
              <TextBlock Classes="muted" FontSize="12.5" Text="{Binding PackMetaLine}"/>
              <Border Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="999" Padding="8,3"
                      Classes.chipok="{Binding !UpdateAvailable}"
                      Classes.chipwarn="{Binding UpdateAvailable}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding ChipText}"/>
              </Border>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
            <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Foreground="{DynamicResource AA.AccentBrush}"
                         Background="#33182024"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}"/>
              <Button Grid.Column="1" Classes="ghost link" Content="{Binding CancelLabel}"
                      Command="{Binding CancelCommand}" Padding="0" MinHeight="20"/>
            </Grid>
          </StackPanel>

          <Button Classes="hudplay" Content="{Binding PlayLabel}" Command="{Binding PlayCommand}"/>
          <Button Classes="ghost link" HorizontalAlignment="Center"
                  Content="{Binding VanillaHudLabel}" Command="{Binding VanillaCommand}"
                  Foreground="#8CE9EAEC" FontSize="12"/>

          <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0"
                ColumnSpacing="8">
            <Button Classes="ghost icon" Width="32" Height="32" MinWidth="32" MinHeight="32"
                    Content="⚙" Foreground="#7EC8E8"
                    Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}"/>
            <TextBlock Grid.Column="1" Classes="muted" FontSize="11" LetterSpacing="1"
                       Text="{Binding HudSysReady}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" IsVisible="{Binding !IsBusy}"/>
            <TextBlock Grid.Column="1" Classes="muted" FontSize="11"
                       Text="{Binding Status}" VerticalAlignment="Center"
                       HorizontalAlignment="Center" IsVisible="{Binding IsBusy}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="2" Classes="muted" FontSize="11" Opacity="0.7"
                       Text="{Binding VersionText}" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>
      </DockPanel>
    </Panel>

    <!-- Concept H — Quiet Wizard -->
    <StackPanel IsVisible="{Binding IsLayoutH}">
      <Grid ColumnDefinitions="40,*,Auto,Auto" Margin="16,12" ColumnSpacing="14"
            MinHeight="48">
        <Border Width="40" Height="40" CornerRadius="6" ClipToBounds="True"
                Background="{DynamicResource AA.PanelBrush}" VerticalAlignment="Center">
          <Image Source="avares://ConceptApp/Assets/icon_256.png" Stretch="UniformToFill"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
          <TextBlock FontSize="14" FontWeight="SemiBold"
                     Text="{Binding PackName}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Classes="muted" FontSize="12"
                     Text="{Binding PackMetaLine}"
                     IsVisible="{Binding !ShowWizardExpand}"/>
          <TextBlock Classes="muted" FontSize="12"
                     Text="{Binding ProgressText}"
                     IsVisible="{Binding ShowWizardBusy}"/>
          <TextBlock FontSize="12" Foreground="#E55B52"
                     Text="{Binding WizardErrorTitle}"
                     IsVisible="{Binding ShowWizardErrorPanel}"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <Button Grid.Column="2" Classes="primary compact" VerticalAlignment="Center" Height="40"
                Content="{Binding PlayLabel}" Command="{Binding PlayCommand}"/>
        <Button Grid.Column="3" Classes="ghost icon" VerticalAlignment="Center"
                Width="40" Height="40" MinWidth="40" MinHeight="40" Padding="0"
                Content="⚙" Command="{Binding SettingsCommand}" ToolTip.Tip="{Binding SettingsTip}"/>
      </Grid>

      <Border IsVisible="{Binding ShowWizardExpand}"
              BorderBrush="{DynamicResource AA.BorderBrush}" BorderThickness="0,1,0,0"
              Background="#181A1E" Padding="16,12,16,14">
        <Panel>
          <!-- Busy strip -->
          <StackPanel Spacing="8" IsVisible="{Binding ShowWizardBusy}">
            <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Progress}"
                         Foreground="{DynamicResource AA.AccentBrush}"
                         Background="{DynamicResource AA.PanelBrush}"/>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Classes="ghost link" Content="{Binding CancelLabel}"
                      Command="{Binding CancelCommand}" Padding="0" MinHeight="20" Margin="12,0,0,0"/>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding ProgressText}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </DockPanel>
          </StackPanel>

          <!-- Error / fix strip -->
          <Grid IsVisible="{Binding ShowWizardErrorPanel}" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Width="28" Height="28" CornerRadius="6" Background="#3C2626"
                    VerticalAlignment="Top">
              <TextBlock Text="!" Foreground="#E55B52" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Spacing="6">
              <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding WizardErrorTitle}"
                         TextWrapping="Wrap"/>
              <TextBlock Classes="muted" FontSize="12" Text="{Binding WizardErrorDetail}"
                         TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                <Button Classes="primary compact" Content="{Binding FixFolderLabel}"
                        Command="{Binding SettingsCommand}" MinHeight="32"/>
                <Button Classes="secondary compact" Content="{Binding RetryLabel}"
                        Command="{Binding RetryCommand}" MinHeight="32"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Panel>
      </Border>
    </StackPanel>
  </Panel>
</Window>
