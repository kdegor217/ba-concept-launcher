<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ActualArrow.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ActualArrowLauncher/Theme/Palette.axaml"/>
        <ResourceInclude Source="avares://ActualArrowLauncher/Theme/Buttons.axaml"/>
        <!-- keep existing Strings.*.axaml includes -->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://ActualArrowLauncher/Theme/Controls.axaml"/>
  </Application.Styles>
</Application>
